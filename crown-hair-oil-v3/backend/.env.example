PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/crown
CORS_ORIGIN=http://localhost:5173

# Admin bootstrap: used only to create the first admin account.
# Use a long unique password (12+ chars), deploy once, then REMOVE the password variable.
# ADMIN_BOOTSTRAP_USERNAME=crown-admin
# ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
# ADMIN_BOOTSTRAP_DISPLAY_NAME=Store Admin
# ADMIN_SESSION_HOURS=8

# Payment gateway secrets belong ONLY on the server when a provider is selected.
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# Shipping provider server credentials belong here when selected.
# SHIPPING_PROVIDER=
# SHIPPING_API_KEY=
